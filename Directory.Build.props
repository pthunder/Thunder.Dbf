<!--
  ProjectThunder :: Thunder.Dbf
  Settings and package metadata shared by every project in the repository.
  Packaging that only applies to packable projects lives in Directory.Build.targets,
  because IsPackable is set by each project after this file is read.
-->
<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>ProjectThunder</Authors>
    <Company>ProjectThunder</Company>
    <Copyright>Copyright (c) 2026 ProjectThunder</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pthunder/Thunder.Dbf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pthunder/Thunder.Dbf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dbase;foxpro;clipper;xbase;dbf;mdx;cdx;ntx;legacy;migration</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Reproducible, debuggable packages. Source Link ships in the .NET SDK (8 and later) and maps
    the PDBs to this commit on GitHub, so no Microsoft.SourceLink.GitHub reference is needed.
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- On CI, paths in PDBs are normalized so the same commit always builds the same bytes. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
