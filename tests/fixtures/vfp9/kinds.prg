* kinds.dbf: one tag of every kind, built by Visual FoxPro 9 SP2. Deterministic: RAND(5), fixed dates.
SET SAFETY OFF
SET CPDIALOG OFF
SET TALK OFF
SET COLLATE TO "MACHINE"
SET NULL OFF
CREATE TABLE kinds FREE (ID I, CODE C(12), NAME C(30), AMOUNT N(12,2), PRICE Y, WHEN D, STAMP T, FLAG L, SCORE B(3), QTY N(6), STATUS C(1), NOTE M, OPT C(10) NULL)
= RAND(5)
FOR lnI = 1 TO 200
    APPEND BLANK
    REPLACE ID WITH lnI, ;
        CODE WITH IIF(lnI % 9 = 0, "", "C" + PADL(INT(RAND() * 80), 5, "0")), ;
        NAME WITH IIF(lnI % 11 = 0, "", CHR(65 + INT(RAND() * 26)) + "name" + TRANSFORM(INT(RAND() * 1000))), ;
        AMOUNT WITH ROUND((RAND() - 0.5) * 2000000, 2), ;
        PRICE WITH NTOM(ROUND((RAND() - 0.4) * 100000, 4)), ;
        WHEN WITH IIF(lnI % 13 = 0, CTOD(""), {^2026-10-31} - INT(RAND() * 40000)), ;
        STAMP WITH IIF(lnI % 17 = 0, CTOT(""), {^2026-10-31 12:00:00} - INT(RAND() * 2000000000)), ;
        FLAG WITH RAND() < 0.5, ;
        SCORE WITH (RAND() - 0.5) * 1000000, ;
        QTY WITH INT((RAND() - 0.3) * 99999), ;
        STATUS WITH IIF(RAND() < 0.6, "A", "B"), ;
        NOTE WITH IIF(lnI % 5 = 0, REPLICATE("note " + TRANSFORM(lnI) + " ", 3), ""), ;
        OPT WITH IIF(RAND() < 0.2, .NULL., "O" + TRANSFORM(INT(RAND() * 50)))
ENDFOR
INDEX ON CODE TAG CODE
INDEX ON UPPER(NAME) TAG UNAME
INDEX ON NAME TAG NAMED DESCENDING
INDEX ON AMOUNT TAG AMOUNT
INDEX ON PRICE TAG PRICE
INDEX ON SCORE TAG SCORE
INDEX ON WHEN TAG WHEN
INDEX ON STAMP TAG STAMP
INDEX ON FLAG TAG FLAG
INDEX ON QTY TAG QTY
INDEX ON CODE + DTOS(WHEN) TAG CODEWHEN
INDEX ON STR(QTY, 6) + CODE TAG QTYCODE
INDEX ON CODE TAG UCODE UNIQUE
INDEX ON ID TAG LIVE FOR STATUS = "A"
INDEX ON OPT TAG OPT
SET COLLATE TO "GENERAL"
INDEX ON NAME TAG GNAME
SET COLLATE TO "MACHINE"
INDEX ON ID TAG ID CANDIDATE
USE
