<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Thunder.Dbf\Thunder.Dbf.csproj" />
    <ProjectReference Include="..\..\src\Thunder.Dbf.Sql\Thunder.Dbf.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>thunder-dbf: check, inspect, import, export and migrate dBASE and FoxPro data from the command line.</Description>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>thunder-dbf</ToolCommandName>
    <AssemblyName>thunder-dbf</AssemblyName>
  </PropertyGroup>

</Project>
