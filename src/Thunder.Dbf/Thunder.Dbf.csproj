<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Pure .NET engine for dBASE, FoxPro and Clipper files: tables, memos and indexes, with dBASE-compatible locking. No native drivers.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thunder.Dbf.Tests" />
  </ItemGroup>

</Project>
