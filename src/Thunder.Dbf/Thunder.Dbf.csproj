<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Thunder.Dbf</PackageId>
    <Title>Thunder.Dbf: DBF reader and writer for dBASE, FoxPro and Clipper</Title>
    <Description>Read and write DBF files in pure .NET without breaking the legacy app: dBASE, FoxPro, Visual FoxPro and Clipper tables, memos and indexes (.dbf, .dbt, .fpt, .mdx, .cdx, .ntx, .ndx), with every index kept up to date as the legacy app would, dBASE- and FoxPro-compatible locking, and crash-safe writes. No ODBC, OLE DB or native drivers.</Description>
    <PackageTags>$(PackageTags);visual-foxpro;visualfoxpro;vfp;dbase-iv;dbf-reader;dbf-writer;shapefile;dbt;fpt;adonet;csv</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- IntelliSense for package users; a public member without docs fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573</WarningsAsErrors>
    <!--
      Safe to trim and compile ahead of time (Native AOT, iOS, Android): turns on the trim, AOT and
      single-file analyzers, so a change that would break a trimmed app fails the build here.
      The reflection-based APIs say what they need with [DynamicallyAccessedMembers] or [Requires...].
      The analyzers' warnings are errors here: an unannotated reflection call, a call to a member
      marked [Requires...], and annotations that don't match.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2090;IL2091;IL2093;IL2111;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thunder.Dbf.Tests" />
  </ItemGroup>

</Project>
