<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Thunder.Dbf</PackageId>
    <Description>Pure .NET engine for dBASE, FoxPro and Clipper files: tables, memos and indexes, with dBASE-compatible locking. No native drivers.</Description>
    <PackageTags>$(PackageTags);visual-foxpro;dbt;fpt;adonet;csv</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- IntelliSense for package users; a public member without docs fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thunder.Dbf.Tests" />
  </ItemGroup>

</Project>
