<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Thunder.Dbf.Server</RootNamespace>
    <AssemblyName>thunder-dbf-server</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- An app, not a library: releases ship it as self-contained zips per OS, not on NuGet. -->
    <IsPackable>false</IsPackable>
    <!-- The Web SDK warns when a solution-wide `dotnet pack` reaches it; skipping it is the intent. -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thunder.Dbf\Thunder.Dbf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thunder.Dbf.Server.Tests" />
  </ItemGroup>

</Project>
