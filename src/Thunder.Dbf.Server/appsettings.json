{
  // Thunder.Dbf server settings. Comments are allowed in this file.
  // Every default is the safe one: read-only, no keys, nothing listed, nothing written.

  "Thunder": {
    "Data": {
      // The legacy app's data folder (the one holding the .dbf files), or a connection string.
      // Examples: "C:\\GoldMine\\Data", "\\\\server\\share\\data", "/srv/legacy/data"
      "Folder": "",

      // The master switch. While true, nothing is ever written, whatever Tables or ApiKeys say.
      "ReadOnly": true

      // Optional: force a code page for every table instead of each table's own (1252, 437, 850, ...).
      // "CodePage": 1252,

      // Optional: read memo fields as null when a table's .dbt/.fpt is missing, instead of failing.
      // "IgnoreMissingMemo": false
    },

    // Per-table switches. Tables not listed here are read-only even when Data:ReadOnly is false.
    "Tables": {
      // "CONTACT1": {
      //   "AllowWrites": true,
      //   // Thunder.Dbf can't update .mdx/.cdx indexes yet. Only allow writes to an indexed table
      //   // if the legacy app reindexes (REINDEX) before it relies on the index.
      //   "AllowUnmaintainedIndexes": false
      // }
    },

    // API keys. Store only the SHA-256 hash, never the key. Make a key and its hash with:
    //   thunder-dbf-server hash-key
    // Clients send the key in the X-Api-Key header.
    "ApiKeys": [
      // {
      //   "Id": "website",                 // shown in logs and the write journal
      //   "Sha256": "<64 hex digits from hash-key>",
      //   "CanListTables": true,           // may call GET /tables and see table names in 404 hints
      //   "Read": [ "CONTACT1", "CAL" ],   // or [ "*" ] for every table in the folder
      //   "Write": [ "CONTACT1" ],         // the table must also have AllowWrites
      //   "Fields": {                      // optional allow-lists: other fields don't exist for this key
      //     "CONTACT1": [ "ACCOUNTNO", "COMPANY", "CONTACT", "PHONE1" ]
      //   }
      // },
      // {
      //   "Id": "reporting",
      //   "Sha256": "<64 hex digits>",
      //   "Read": [ "*" ]
      // }
    ],

    // Optional: sign-in with OpenID Connect (Entra ID, Auth0, Keycloak, ...) beside the API keys.
    // Off while Authority is empty. Clients send "Authorization: Bearer <access token>", never
    // together with X-Api-Key. A token's roles, groups or claims pick a profile, shaped like an
    // API key's permissions; the first rule in Map that matches wins. No match: 403.
    "OpenIdConnect": {
      "Authority": ""
      // "Authority": "https://login.microsoftonline.com/<tenant id>/v2.0",
      // "Audience": "<the API's application id>", // tokens issued for other apps are refused
      // "Profiles": {
      //   "clerks":    { "Read": [ "CONTACT1" ], "Write": [ "CONTACT1" ],
      //                  "Fields": { "CONTACT1": [ "ACCOUNTNO", "COMPANY", "CONTACT", "PHONE1" ] } },
      //   "reporting": { "Read": [ "*" ], "CanListTables": true }
      // },
      // "Map": [
      //   { "Role": "Thunder.Clerk", "Profile": "clerks" },
      //   { "Group": "<group object id>", "Profile": "reporting" }
      // ]
    },

    "Paging": {
      "DefaultTake": 50,
      "MaxTake": 500                     // take is capped at this, whatever the client asks for
    },

    // Every write is appended here as one JSON line: time, key id, table, record, before and after.
    // Relative paths start at the service's folder. Keep it outside the data folder.
    "Journal": {
      "Path": "journal/writes.jsonl"
    },

    // Before the first write to a table after startup, its .dbf/.dbt/.fpt/.mdx/.cdx are copied
    // to a timestamped folder under here.
    "Backups": {
      "Folder": "backups"
    },

    "RateLimit": {
      "PerKeyPerMinute": 600,
      "AnonymousPerMinute": 60           // per address, before a valid key is seen
    },

    // How long a request waits for another request on the same table before answering 503.
    "LockTimeoutSeconds": 30
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
